  background: #fff;
  display: grid;
  gap: 8px;
}

.stage b {
  font-size: 14px;
}

.stage span {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.35;
}

.relationship-table,
.request-table,
.permission-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.formula-studio {
  margin-bottom: 14px;
}

.formula-body {
  display: grid;
  grid-template-columns: 360px minmax(0, 1fr);
  min-height: 330px;
}

.formula-list {
  padding: 12px;
  border-right: 1px solid var(--line);
  background: #f8fbfd;
  display: grid;
  align-content: start;
  gap: 8px;
}

.formula-item {
  width: 100%;
  min-height: 58px;
  padding: 10px 11px;
  border: 1px solid #dbe7ef;
  border-radius: 7px;
  background: #fff;
  color: var(--ink);
  text-align: left;
}

.formula-item.active {
  border-color: #83bfe4;
  background: #eef8fe;
}

.formula-item b,
.formula-item span {
  display: block;
}

.formula-item small {
  float: right;
  max-width: 145px;
  color: #63798f;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.formula-item span {
  margin-top: 5px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  font-size: 11px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.formula-editor {
  padding: 14px;
  display: grid;
  grid-template-rows: 1fr auto;
  gap: 12px;
}

.formula-editor label {
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 7px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.formula-editor textarea {
  min-height: 190px;
  width: 100%;
  padding: 13px;
  border: 1px solid #cddae7;
  border-radius: 7px;
  color: #001f5e;
  background: #fffdf0;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  font-size: 13px;
  line-height: 1.45;
  resize: vertical;
}

.formula-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}

.formula-meta div {
  padding: 10px;
  border: 1px solid #e0e9f1;
  border-radius: 7px;
  background: #fbfdff;
}

.formula-meta b,
.formula-meta span {
  display: block;
}

.formula-meta span {
  margin-top: 4px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.35;
}

.relationship-table {
  display: grid;
}

.rel-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 30px minmax(0, 1fr) 90px;
  gap: 10px;
  min-height: 42px;
  padding: 0 15px;
  align-items: center;
  border-top: 1px solid var(--line);
}

.rel-row:first-child {
  border-top: 0;
}

.calculation-console-body {
  padding: 14px;
  display: grid;
  gap: 14px;
}

.calc-status-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}

.calc-status-grid div {
  min-height: 78px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #f9fcff;
  display: grid;
  align-content: start;
  gap: 4px;
}

.calc-status-grid span,
.calc-status-grid small {
  color: var(--muted);
  font-size: 10px;
}

.calc-status-grid b {
  font-size: 16px;
}

.compact-pipeline {
  margin-bottom: 0;
}

.compact-pipeline .stage {
  min-height: 84px;
}

.compact-relationships {
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
}

.calculation-workbench {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  gap: 12px;
}

.calc-card {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
}

.calc-card header {
  min-height: 62px;
  padding: 12px;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.calc-card h4 {
  margin: 2px 0 0;
  font-size: 15px;
}

.calc-control-row {
  padding: 10px 12px 0;
}

.calc-control-row select,
.calc-formula-grid select,
.calc-formula-grid textarea,
.calc-input-field input,
.calc-input-field select {
  width: 100%;
  border: 1px solid #cfddea;
  border-radius: 7px;
  background: #fff;
  color: var(--ink);
  font: inherit;
}

.calc-control-row select,
.calc-formula-grid select,
.calc-input-field input,
.calc-input-field select {
  min-height: 36px;
  padding: 0 10px;
}

.management-input-controls {
  padding: 12px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.calc-input-field {
  display: grid;
  gap: 5px;
}

.calc-input-field span {
  color: var(--muted);
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.calc-input-field input.numeric {
  text-align: right;
}

.calc-formula-grid {
  padding: 12px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 9px;
}

.calc-formula-grid textarea {
  grid-column: 1 / -1;
  min-height: 118px;
  padding: 10px;
  background: #fffdf0;
  color: #001f5e;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  font-size: 12px;
  resize: vertical;
}

.calc-card-actions {
  padding: 0 12px 12px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.request-table th,
.request-table td,
.permission-table th,
.permission-table td {
  height: 42px;
  padding: 0 12px;
  border-top: 1px solid var(--line);
  text-align: left;
}

.request-table th,
.permission-table th {
  background: #f7fafd;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
}

.request-table button {
  min-height: 30px;
  padding: 0 10px;
}

.bar-chart {
  padding: 18px 18px 12px;
  display: grid;
  gap: 13px;
}

.bar-row {
  display: grid;
  grid-template-columns: 190px 1fr 112px;
  gap: 12px;
  align-items: center;
}

.bar-track {
  height: 18px;
  border-radius: 999px;
  background: #e8f0f6;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--blue);
}

.bar-fill.red {
  background: var(--red);
}

.bar-row b {
  text-align: right;
}

.role-list {
  padding: 15px;
  display: grid;
  gap: 8px;
}

.role {
  min-height: 58px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: #fff;
  color: var(--ink);
  text-align: left;
  font-weight: 900;
}

.role.active {
  border-color: #83bfe4;
  background: #eef8fe;
}

.role span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 500;
}

@media (max-width: 900px) {
  body {
    min-width: 0;
  }

  .topbar,
  .workspace,
  .overview-grid,
  .dashboard-grid,
  .checks-grid,
  .access-grid,
  .input-layout,
  .mc-workspace,
  .report-workspace {
    grid-template-columns: 1fr;
  }

  .topbar,
  .tenant-controls,
  .mc-header,
  .page-head {
    align-items: stretch;
    flex-direction: column;
  }

  .workspace,
  .market-strip {
    width: calc(100% - 24px);
  }

  #dashboards.view.active {
    height: auto;
    min-height: 0;
    overflow: visible;
  }

  #dashboards .report-workspace {
    height: auto;
  }

  .report-dashboard .wide {
    grid-column: auto;
  }

  .report-list,
  .financial-grid-scroll {
    max-height: 70vh;
  }

  .metrics-grid,
  .mobile-report-strip,
  .architecture-grid,
  .pipeline,
  .form-grid,
  .mc-stats,
  .management-setting-list,
  .management-grid,
  .formula-body,
  .formula-meta,
  .statement-list,
  .ifrs-chart-grid,
  .report-kpis,
  .dashboard-kpis,
  .two-col-statements,
  .report-preview-grid {
    grid-template-columns: 1fr;
  }

  .statement-scroll {
    max-height: 70vh;
  }

  .formula-list {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .management-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .mc-tabs {
    width: 100%;
    overflow-x: auto;
  }
}

/* Typography comfort pass: keep hierarchy, reduce glare from heavy bold text. */
:root {
  --ink-soft: #17324a;
  --blue-soft: #176fae;
  --blue-text: #1266a8;
}

.brand-lockup span,
.eyebrow,
.field span,
.metric span,
.formula-editor label {
  color: var(--blue-soft);
  font-weight: 650;
}

.tenant-controls label,
.market-strip span,
.module,
.primary-button,
.secondary-button,
.danger-button,
.icon-button,
.request-table button,
.panel-actions select,
.status-pill,
.risk,
.field input,
.field select,
.role {
  font-weight: 650;
}

.brand-lockup h1,
.page-head h2,
.panel h3,
.metric strong,
.sheet-button strong,
.dependency-list b,
.analysis-list b,
.timeline b,
.check-list b,
.architecture-grid b,
.stage b,
.rel-row b,
.bar-row b,
.formula-item b,
.formula-meta b,
.drop-zone strong,
.sidebar-card strong {
  color: var(--ink-soft);
  font-weight: 650;
}

.page-head h2 {
  font-size: 24px;
}

.metric strong {
  font-weight: 620;
}

.sheet-button strong,
.module {
  font-size: 15px;
}

.field input,
.field select {
  color: var(--blue-text);
}

.mini-icon,
.icon-button span,
.file-mark {
  font-weight: 700;
}

.formula-editor textarea {
  color: #173a66;
  font-weight: 500;
}
