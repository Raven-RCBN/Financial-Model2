:root {
  --ink: #082038;
  --muted: #63788d;
  --blue: #0870c0;
  --sky: #36a4e8;
  --bg: #f4f7fa;
  --line: #d9e3ec;
  --card: #ffffff;
  --amber: #d99a2b;
  --red: #c54f5b;
  --green: #27835d;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 1180px;
  color: var(--ink);
  background: var(--bg);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
}

.topbar {
  min-height: 94px;
  padding: 16px 22px;
  border-bottom: 1px solid var(--line);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-lockup img {
  width: 54px;
  height: 54px;
  object-fit: cover;
  object-position: 50% 38%;
  border: 1px solid var(--line);
  background: #fff;
}

.brand-lockup span,
.eyebrow {
  color: var(--blue);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin: 0;
  letter-spacing: 0;
}

.brand-lockup h1 {
  margin-top: 4px;
  font-size: 26px;
  line-height: 1.15;
}

.tenant-controls {
  display: flex;
  align-items: end;
  gap: 10px;
}

.tenant-controls label {
  display: grid;
  gap: 4px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 800;
}

.tenant-controls input,
.tenant-controls select,
.search {
  min-height: 40px;
  min-width: 174px;
  padding: 0 12px;
  border: 1px solid #cddae7;
  border-radius: 6px;
  color: var(--ink);
  background: #fff;
  font-weight: 700;
}

.market-strip {
  margin: 20px auto 14px;
  width: calc(100% - 58px);
  min-height: 48px;
  padding: 0 16px;
  border-radius: 7px;
  background: var(--ink);
  color: #d7e7f3;
  display: flex;
  align-items: center;
  gap: 0;
  overflow: hidden;
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(8, 32, 56, 0.12);
}

.market-strip > b {
  flex: 0 0 auto;
  height: 48px;
  margin-left: -16px;
  padding: 0 16px;
  background: #103454;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.market-strip > b span {
  color: #91bdd9;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
}

.ticker-window {
  min-width: 0;
  overflow: hidden;
  flex: 1;
}

.ticker-track {
  --ticker-duration: 28s;
  display: inline-flex;
  align-items: center;
  gap: 28px;
  min-width: max-content;
  padding-left: 28px;
  animation: ticker-scroll var(--ticker-duration) linear infinite;
}

.ticker-track:hover {
  animation-play-state: paused;
}

.ticker-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #91bdd9;
  font-size: 13px;
  font-weight: 650;
  text-transform: uppercase;
}

.ticker-item b {
  color: #91bdd9;
  font-weight: 720;
}

.ticker-item strong {
  color: #ffcf5f;
  font-weight: 720;
  text-transform: none;
}

.ticker-item em {
  color: #d7e7f3;
  font-style: normal;
  font-weight: 560;
  text-transform: none;
}

.ticker-item.live::before,
.ticker-item.database::before {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  content: "";
  background: #4fd1a5;
}

.ticker-item.database::before {
  background: #8cc4ff;
}

@keyframes ticker-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .ticker-track {
    animation: none;
    overflow-x: auto;
    max-width: 100%;
  }
}

.workspace {
  width: calc(100% - 58px);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 244px minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

.sidebar {
  position: sticky;
  top: 14px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  display: grid;
  gap: 8px;
}

.module {
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  text-align: left;
}

.module.active,
.module:hover {
  border-color: #cfe2f0;
  background: #eff7fd;
  color: var(--blue);
}

.mini-icon,
.icon-button span {
  width: 26px;
  height: 26px;
  border-radius: 5px;
  background: #e6f3fb;
  color: var(--blue);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.sidebar-card {
  margin-top: 12px;
  padding: 13px;
  border: 1px solid #cfe2f0;
  border-radius: 7px;
  background: #f7fbfe;
  display: grid;
  gap: 6px;
}

.sidebar-card span,
.sidebar-card small {
  color: var(--muted);
  font-size: 11px;
}

.sidebar-card strong {
  font-size: 14px;
}

.content {
  min-width: 0;
  padding-bottom: 30px;
}

.view {
  display: none;
}

.view.active {
  display: block;
}

.page-head {
  margin-bottom: 14px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.page-head.compact {
  min-height: 80px;
}

.page-head h2 {
  margin-top: 4px;
  font-size: 25px;
  line-height: 1.2;
}

.page-head p {
  margin-top: 6px;
  max-width: 770px;
  color: var(--muted);
  font-size: 14px;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.primary-button,
.icon-button,
.request-table button,
.secondary-button,
.danger-button {
  min-height: 40px;
  border: 1px solid var(--blue);
  border-radius: 6px;
  background: var(--blue);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 800;
}

.primary-button,
.secondary-button,
.danger-button {
  padding: 0 14px;
}

.secondary-button {
  border-color: #cddfec;
  background: #fff;
  color: var(--ink);
}

.danger-button {
  border-color: #f0c8cd;
  background: #fff8f8;
  color: #a63e4b;
}

.icon-button {
  width: 40px;
  padding: 0;
  background: #fff;
}

.metrics-grid {
  margin-bottom: 14px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 8px;
}

.mobile-report-strip {
  margin-bottom: 14px;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.mobile-report-strip article {
  min-height: 88px;
  padding: 13px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  display: grid;
  align-content: start;
  gap: 6px;
}

.mobile-report-strip span {
  color: var(--blue-soft, #176fae);
  font-size: 10px;
  font-weight: 650;
  text-transform: uppercase;
}

.mobile-report-strip strong {
  color: var(--ink-soft, #17324a);
  font-size: 19px;
  font-weight: 650;
}

.mobile-report-strip small {
  color: var(--muted);
  font-size: 11px;
}

.metric {
  min-height: 86px;
  padding: 11px 12px;
  border: 1px solid var(--line);
  border-top: 2px solid #6db2df;
  border-radius: 8px;
  background: #fff;
  display: grid;
  align-content: start;
  gap: 6px;
  min-width: 0;
}

.metric span {
  color: var(--muted);
  font-size: 9.5px;
  font-weight: 650;
  text-transform: uppercase;
}

.metric strong {
  width: 100%;
  overflow: hidden;
  color: #17324a;
  font-size: clamp(16px, 1.2vw, 19px);
  font-weight: 620;
  line-height: 1.05;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.metric small {
  color: var(--muted);
  font-size: 10.5px;
}

.overview-grid,
.dashboard-grid,
.checks-grid,
.access-grid {
  display: grid;
  grid-template-columns: 1.12fr 0.88fr;
  gap: 14px;
  margin-bottom: 14px;
}

.report-workspace {
  margin-bottom: 14px;
  display: grid;
  grid-template-columns: 410px minmax(0, 1fr);
  gap: 14px;
  align-items: stretch;
}

#dashboards.view.active {
  height: auto;
  min-height: 0;
  overflow: visible;
}

#dashboards .report-workspace {
  height: min(660px, calc(100vh - 198px));
  min-height: 0;
}

#dashboards .dashboard-grid {
  display: grid;
  margin-top: 14px;
}

.panel {
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
}

.report-library,
.report-preview {
  min-height: 0;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
}

.panel.wide {
  grid-column: span 1;
}

.panel > header {
  min-height: 62px;
  padding: 13px 15px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.panel-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
}

.input-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  flex-wrap: wrap;
}

.panel-actions select {
  min-height: 40px;
  min-width: 210px;
  padding: 0 11px;
  border: 1px solid #cddae7;
  border-radius: 6px;
  color: var(--ink);
  background: #fff;
  font-weight: 800;
}

.panel h3 {
  margin-top: 3px;
  font-size: 17px;
}

.status-pill,
.risk {
  padding: 6px 10px;
  border-radius: 999px;
  background: #eaf6ef;
  color: var(--green);
  font-size: 12px;
  font-weight: 900;
  white-space: nowrap;
}

.status-pill.amber,
.risk.med {
  background: #fff7e5;
  color: #9a6616;
}

.status-pill.red,
.risk.high {
  background: #fff0f2;
  color: #a63e4b;
}

.risk.low {
  background: #eaf6ef;
  color: var(--green);
}

.drop-zone {
  margin: 15px;
  padding: 16px;
  border: 1px dashed #abc9dd;
  border-radius: 8px;
  background: #f8fcff;
  display: flex;
  align-items: center;
  gap: 14px;
}

.file-mark {
  width: 60px;
  height: 60px;
  border-radius: 7px;
  background: #0f6fac;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 900;
  text-transform: uppercase;
}

.drop-zone strong,
.drop-zone span {
  display: block;
}

.drop-zone span {
  margin-top: 5px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.capture-steps {
  padding: 0 15px 15px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.capture-steps div,
.architecture-grid div,
.analysis-list div,
.timeline div,
.check-list div,
.dependency-list div {
  padding: 12px;
  border: 1px solid #e0e9f1;
  border-radius: 7px;
  background: #fbfdff;
}

.capture-steps b {
  width: 24px;
  height: 24px;
  margin-right: 8px;
  border-radius: 50%;
  background: #e6f3fb;
  color: var(--blue);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}

.dependency-list,
.analysis-list,
.timeline,
.check-list,
.report-list {
  padding: 15px;
  display: grid;
  gap: 10px;
}

.report-list {
  max-height: none;
  height: 100%;
  overflow: auto;
}

.report-group {
  display: grid;
  gap: 7px;
}

.report-group h4,
.report-preview-grid h4 {
  margin: 6px 2px 2px;
  color: var(--muted-strong, #526a80);
  font-size: 11px;
  font-weight: 650;
  text-transform: uppercase;
}

.report-card {
  width: 100%;
  min-height: 62px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  color: var(--ink);
  text-align: left;
}

.report-card.active {
  border-color: #83bfe4;
  background: #eef8fe;
}

.report-card strong,
.report-card span {
  display: block;
}

.report-card strong {
  color: var(--ink-soft, #17324a);
  font-weight: 650;
}

.report-card span {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.35;
}

.report-detail {
  padding: 15px;
  display: grid;
  gap: 14px;
  min-height: 0;
  overflow: hidden;
}

.report-output {
  display: grid;
  gap: 10px;
  min-height: 0;
  overflow: auto;
}

.workbook-report {
  gap: 0;
  min-height: 0;
  overflow: hidden;
  grid-template-rows: auto minmax(0, 1fr);
}

.workbook-report-title {
  padding: 12px 14px;
  border: 1px solid #cbd8e4;
  border-bottom: 0;
  border-radius: 8px 8px 0 0;
  background: #24476c;
  color: #fff;
  display: grid;
  gap: 2px;
}

.workbook-report-title strong,
.workbook-report-title span,
.workbook-report-title b {
  display: block;
}

.workbook-report-title strong {
  font-size: 13px;
  font-weight: 680;
}

.workbook-report-title span,
.workbook-report-title b {
  font-size: 11px;
  font-weight: 560;
}

.financial-grid-scroll {
  max-width: 100%;
  max-height: 100%;
  overflow: auto;
  border: 1px solid #cbd8e4;
  border-radius: 0 0 8px 8px;
  background: #fff;
}

.financial-grid {
  min-width: 1680px;
  width: max-content;
  border-collapse: collapse;
  font-size: 11px;
}

.financial-grid th,
.financial-grid td {
  min-width: 58px;
  padding: 5px 7px;
  border: 1px solid #d7e0e8;
  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.financial-grid th {
  position: sticky;
  top: 0;
  z-index: 2;
  background: #24476c;
  color: #fff;
  font-weight: 650;
}

.financial-grid thead tr:nth-child(2) th {
  top: 27px;
}

.financial-grid .sticky-label {
  left: 0;
  z-index: 3;
  min-width: 245px;
  max-width: 245px;
  text-align: left;
  white-space: normal;
}

.financial-grid td.sticky-label {
  background: #fff;
  color: #17324a;
  font-weight: 560;
}

.financial-grid tr.section td {
  background: #dcecc6;
  color: #17324a;
  font-weight: 680;
  text-align: left;
}

.financial-grid tr.section td:not(.sticky-label) {
  color: transparent;
}

.financial-grid tr.subheader td,
.financial-grid tr.total td {
  font-weight: 680;
}

.financial-grid tr.blue-total td {
  background: #002060;
  color: #fff;
  font-weight: 680;
}

.financial-grid tr.blue-total td.sticky-label {
  background: #002060;
  color: #fff;
}

.financial-grid.worksheet-grid {
  min-width: 1180px;
}

.financial-grid.worksheet-grid th,
.financial-grid.worksheet-grid td {
  min-width: 72px;
}

.financial-grid.worksheet-grid .sticky-label {
  min-width: 180px;
  max-width: 240px;
}

.financial-grid.worksheet-grid.budget-grid .sticky-label {
  min-width: 360px;
  max-width: 440px;
}

.financial-grid.worksheet-grid.budget-grid th,
.financial-grid.worksheet-grid.budget-grid td {
  min-width: 76px;
}

.financial-grid.worksheet-grid tr.dark td,
.financial-grid.worksheet-grid td.dark {
  background: #24476c;
  color: #fff;
  font-weight: 650;
}

.financial-grid.worksheet-grid tr.section td,
.financial-grid.worksheet-grid td.green {
  background: #dcecc6;
  color: #17324a;
}

.financial-grid.worksheet-grid tr.yellow td,
.financial-grid.worksheet-grid td.yellow {
  background: #fffbe8;
}

.financial-grid.worksheet-grid td.bold,
.financial-grid.worksheet-grid tr.subheader td {
  font-weight: 650;
}

.financial-grid.worksheet-grid td.center {
  text-align: center;
}

.financial-grid.worksheet-grid td.number {
  text-align: right;
}

.input-workbook-table {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 10px;
  min-height: 0;
}

.input-table-summary,
.input-grid-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted, #6f8397);
  font-size: 12px;
  flex-wrap: wrap;
}

.input-grid-toolbar {
  padding: 10px 12px;
  border: 1px solid #dce8f2;
  border-radius: 7px;
  background: #f8fbfe;
}

.input-grid-toolbar > div:first-child {
  display: grid;
  gap: 3px;
}

.input-table-summary strong,
.input-grid-toolbar strong {
  color: var(--ink, #16324a);
  font-weight: 650;
}

.input-table-pager {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.input-table-pager .secondary-button,
.input-table-pager .primary-button {
  min-height: 28px;
  padding: 0 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 650;
}

.input-table-pager .mini-icon {
  width: 20px;
  height: 20px;
  border-radius: 4px;
  font-size: 10px;
}

.input-table-pager span {
  color: var(--muted);
  font-size: 11px;
  white-space: nowrap;
}

.input-table-pager button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.grid-add-row {
  display: flex;
  justify-content: flex-end;
}

.mapped-controls {
  display: grid;
  gap: 10px;
}

.mapped-controls.collapsed {
  max-height: 72px;
  padding-top: 8px;
  border-top: 1px solid var(--line);
  overflow: hidden;
}

.mapped-controls.collapsed .linked-form-grid {
  display: none;
}

.linked-form-grid {
  padding: 0;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
}

.input-workbook-table .financial-grid-scroll {
  max-height: 100%;
  overflow: auto;
}

.financial-grid.input-grid .actions-col {
  min-width: 78px;
  text-align: center;
  background: #fff;
  position: sticky;
  right: 0;
  z-index: 2;
}

.financial-grid.input-grid th.actions-col {
  background: #f6f9fc;
  color: #41546a;
}

.financial-grid.input-grid td.actions-col .row-actions {
  justify-content: center;
  height: 30px;
  gap: 6px;
}

.financial-grid.input-grid .action-icon {
  width: 30px;
  height: 30px;
  border-radius: 7px;
}

.financial-grid.input-grid .action-icon svg {
  width: 15px;
  height: 15px;
}

.financial-grid.input-grid td {
  padding: 0;
}

.input-cell-control {
  width: 100%;
  min-width: 84px;
  height: 30px;
  padding: 0 8px;
  border: 0;
  color: var(--ink);
  background: transparent;
  font-size: 11.5px;
  font-weight: 560;
}

.input-cell-control:focus {
  outline: 2px solid var(--blue);
  outline-offset: -2px;
  background: #fffdf0;
}

.input-cell-control.saving {
  background: #eef8fe;
}

.input-cell-control.numeric {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.financial-grid td.negative {
  color: #d31313;
}

.report-output h4 {
  margin: 0 2px;
  color: var(--muted-strong, #526a80);
  font-size: 11px;
  font-weight: 650;
  text-transform: uppercase;
}

.statement-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.statement-list div {
  min-height: 72px;
  padding: 12px 14px;
  border: 1px solid #dce8f2;
